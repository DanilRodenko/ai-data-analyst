# Copy to .env and fill in. Never commit .env.

# Main LLM for router, analyst, synthesizer: groq | anthropic | openai
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Visualizer always uses Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Only needed if LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: tracing is on only when the key is set
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=ai-data-analyst